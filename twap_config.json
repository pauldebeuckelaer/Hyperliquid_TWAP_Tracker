{
  "symbols": ["HYPE"],

  "hypurr_data": {
    "base_url": "https://api.hypurrscan.io",
    "timeout_seconds": 30,
    "rate_limit_delay": 0.1
  },

  "hyperliquid": {
    "enabled": true,
    "api_url": "https://api.hyperliquid.xyz",
    "timeout": 10,
    "rate_limit_delay": 0.5,
    "metrics_collection": {
      "light_interval_hours": 6,
      "deep_interval_hours": 24
    }
  },

  "all_coins_tracking": {
    "enabled": true,
    "exclude_coins": []
  },

  "logging": {
    "root_level": "INFO",
    "console": true,
    "console_modules": ["twap_state_tracker"],
    "files": [
      {
        "path": "twap_tracker.log",
        "modules": ["twap_state_tracker", "hypurrscan_client"]
      },
      {
        "path": "allcoins_tracker.log",
        "modules": ["allcoins_state_tracker"]
      },
      {
        "path": "main.log",
        "modules": ["main", "__main__", "trader_metrics_manager"]
      }
    ],
    "modules": {
      "api_client.hypurrscan_client": "INFO",
      "api_client.hyperliquid_client": "INFO",
      "twap_state_tracker": "INFO",
      "allcoins_state_tracker": "INFO",
      "trader_metrics_manager": "INFO",
      "__main__": "DEBUG"
    }

  },
  "json_logging": {
    "enabled": true,
    "log_dir": "json_logs"
  }
}