{
  "symbols": ["HYPE"],

  "hypurr_data": {
    "base_url": "https://api.hypurrscan.io",
    "timeout_seconds": 30,
    "rate_limit_delay": 0.1
  },

  "hyperliquid": {
    "enabled": true,
    "api_url": "https://api.hyperliquid.xyz",
    "timeout": 10,
    "rate_limit_delay": 0.5,

    "_comment_liquidation_tracker": "LiquidationTracker is now a pure analyzer (Step 3). Config kept for compatibility but only used for unused init parameters.",
    "liquidation_tracker": {},

    "_comment_metrics_collection": "Shared by WhaleDiscovery and WhaleStateCollector. min_portfolio_value is the $50K floor for whale qualification. batch_size/batch_delay control Collector's fast-ladder fetch concurrency.",
    "metrics_collection": {
      "min_portfolio_value": 50000,
      "hip3_tracking_enabled": true,
      "batch_size": 50,
      "batch_delay": 0.5,
      "hip3_batch_size": 50,
      "hip3_batch_delay": 0.5
    },

    "market_data": {
      "hip3_tracking_enabled": true
    },
    "hip3_ws_discovery": {
      "enabled": false,
      "min_portfolio_value": 50000,
      "flag_floor": 100000,
      "worker_sleep": 3.0,
      "queue_max": 500,
      "processed_reset_hours": 24
    }
  },

  "hypurr_fees": {
    "collection_enabled": true,
    "poll_interval_cycles": 60
  },

  "all_coins_tracking": {
    "enabled": true,
    "exclude_coins": []
  },

  "logging": {
    "root_level": "INFO",
    "console": true,
    "console_modules": ["trackers.state_tracker"],
    "files": [
      {
        "path": "logs/allcoins_tracker.log",
        "modules": ["trackers.state_tracker"]
      },
      {
        "path": "logs/main.log",
        "modules": [
          "main",
          "__main__",
          "trackers.fees_collector",
          "trackers.whale_discovery",
          "trackers.whale_state_collector"
        ]
      },
      {
        "path": "logs/whale_events.log",
        "modules": ["trackers.whale_event_detector"]
      },
      {
        "path": "logs/liquidation_coins.log",
        "modules": ["trackers.liquidation_tracker.coins"]
      },
      {
        "path": "logs/liquidation_addresses.log",
        "modules": ["trackers.liquidation_tracker.addresses"]
      },
      {
        "path": "logs/tier_manager.log",
        "modules": ["trackers.tier_manager"]
      },
      {
        "path": "logs/axis_position.log",
        "modules": ["axis.position"]
      }
    ],
    "modules": {
      "api_client.hypurrscan_client": "INFO",
      "api_client.hyperliquid_client": "WARNING",
      "trackers.state_tracker": "INFO",
      "trackers.market_data_tracker": "INFO",
      "trackers.liquidation_tracker": "INFO",
      "trackers.tier_manager": "DEBUG",
      "axis.position": "INFO",
      "trackers.whale_event_detector": "DEBUG",
      "trackers.whale_discovery": "INFO",
      "trackers.whale_state_collector": "INFO",
      "trackers.fees_collector": "INFO",
      "coin_registry": "DEBUG",
      "__main__": "DEBUG"
    }
  },

  "json_logging": {
    "enabled": true,
    "log_dir": "data/json_logs"
  }
}