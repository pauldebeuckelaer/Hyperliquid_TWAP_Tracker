{
  "symbols": ["HYPE"],

  "hypurr_data": {
    "base_url": "https://api.hypurrscan.io",
    "timeout_seconds": 30,
    "rate_limit_delay": 0.1
  },

  "hyperliquid": {
    "enabled": true,
    "api_url": "https://api.hyperliquid.xyz",
    "timeout": 10,
    "rate_limit_delay": 0.5,
    "metrics_collection": {
      "light_interval_hours": 6,
      "deep_interval_hours": 24
    }
  },

  "all_coins_tracking": {
    "enabled": true,
    "exclude_coins": []
  },

  "logging": {
    "root_level": "INFO",
    "console": true,
    "console_modules": ["trackers.state_tracker"],
    "files": [
      {
        "path": "logs/allcoins_tracker.log",
        "modules": ["trackers.state_tracker"]
      },
      {
        "path": "logs/main.log",
        "modules": ["main", "__main__", "trader_metrics_manager", "api_client.hyperliquid_client"]
      }
    ],
    "modules": {
      "api_client.hypurrscan_client": "INFO",
      "api_client.hyperliquid_client": "WARNING",
      "trackers.state_tracker": "INFO",
      "trackers.market_data_tracker": "INFO",
      "trader_metrics_manager": "DEBUG",
      "coin_registry": "DEBUG",
      "__main__": "DEBUG"
    }
  },

  "json_logging": {
    "enabled": true,
    "log_dir": "data/json_logs"
  }
}